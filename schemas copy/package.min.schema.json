{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "package.json (minimal, offline)",
  "type": "object",
  "properties": {
    "name": { "type": "string" },
    "version": { "type": "string" },
    "private": { "type": "boolean" },
    "type": { "enum": ["commonjs", "module"] },
    "scripts": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "devDependencies": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "peerDependencies": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "packageManager": { "type": "string" }
  },
  "additionalProperties": true
}
